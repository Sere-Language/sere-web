# Copy to .env and fill in.
# Everything is optional except the Supabase pair, which developer accounts and
# the package registry both need.

# --- GitHub -------------------------------------------------------------------
# Raises the API rate limits used by the releases, issues and docs pages.
GITHUB_TOKEN=

# --- Supabase (required for accounts and the registry) ------------------------
# Project URL and publishable key. These two are build-time public values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Verifies publish tokens and writes packages. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Developer accounts -------------------------------------------------------
# Activates an account without sending email. Use it when this deployment has no
# mail sender: sign-up and sign-in then confirm the account, but only after the
# provider has verified the password, so nobody can claim someone else's address.
# Turn it off once email delivery works — it skips email verification.
DEVELOPER_AUTO_CONFIRM=false

# --- Package publishing -------------------------------------------------------
# Optional shared secret for CI, sent as the `x-publish-token` header. Minimum
# 24 characters. Developer tokens from /developers are preferred for anything
# long-lived, because they can be revoked individually.
PACKAGE_PUBLISH_TOKEN=

# --- Privacy ------------------------------------------------------------------
# Pepper for the hashed IPs kept by rate limiting and the audit log.
IP_HASH_SALT=

# --- Absolute URLs ------------------------------------------------------------
# Overrides the canonical origin used for metadata, sitemaps and canonical URLs.
NEXT_PUBLIC_SITE_URL=
